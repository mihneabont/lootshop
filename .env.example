# Copy to .env.local for local development, and add the same values in Vercel.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public address of the site (used in emails)
NEXT_PUBLIC_SITE_URL=https://giveaway.lootshop.ro

# Web push: generate with `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@lootshop.ro

# Email through Resend (resend.com); verify the lootshop.ro domain there
RESEND_API_KEY=
EMAIL_FROM=Loot Shop <giveaway@lootshop.ro>
EMAIL_REPLY_TO=contact@lootshop.ro

# Optional: WooCommerce → Settings → Advanced → REST API (Read/Write key)
# When set, each winner automatically gets a single-use coupon.
WC_SITE_URL=https://lootshop.ro
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=

# Organizer details shown in the official rules and privacy policy
NEXT_PUBLIC_COMPANY_NAME=
NEXT_PUBLIC_COMPANY_CUI=
NEXT_PUBLIC_COMPANY_REG=
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_CONTACT_EMAIL=contact@lootshop.ro
