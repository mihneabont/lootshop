# Copy to .env.local for local development (`npm run dev`).
# On GitHub these come from Settings → Secrets and variables → Actions (see README).

# Supabase → Project Settings → API (both values are public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_KEY=your-publishable-key

# Web push public key, from `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Sub-path the site is served from (GitHub Pages sets this automatically)
NEXT_PUBLIC_BASE_PATH=

# Organizer details shown in the official rules and privacy policy
NEXT_PUBLIC_COMPANY_NAME=
NEXT_PUBLIC_COMPANY_CUI=
NEXT_PUBLIC_COMPANY_REG=
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_CONTACT_EMAIL=contact@lootshop.ro
